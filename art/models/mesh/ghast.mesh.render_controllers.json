{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ghast.mesh": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.shooting"
          ]
        }
      },
      "geometry": "Geometry.mesh",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "((variable.ischarging) ? Texture.mesh_alt : Texture.mesh)"
      ]
    }
  }
}
