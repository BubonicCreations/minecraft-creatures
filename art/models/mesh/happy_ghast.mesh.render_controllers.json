{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.happy_ghast.mesh": {
      "geometry": "(!query.is_baby) ? Geometry.mesh : (Geometry.default)",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "(!query.is_baby) ? Texture.mesh : (query.is_baby ? Texture.ghastling : Texture.happy_ghast)"
      ],
      "part_visibility": [
        {
          "*": "!query.is_invisible"
        }
      ]
    }
  }
}
