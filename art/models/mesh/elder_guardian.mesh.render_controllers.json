{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.guardian.elder_mesh": {
      "geometry": "(query.is_elder && !query.is_ghost) ? Geometry.mesh : (Geometry.default)",
      "materials": [
        {
          "*": "query.is_ghost ? Material.ghost : Material.default"
        }
      ],
      "textures": [
        "(query.is_elder && !query.is_ghost) ? Texture.mesh : (query.is_elder ? Texture.elder : Texture.default)"
      ]
    }
  }
}
