{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:squid",
      "materials": {
        "default": "squid"
      },
      "textures": {
        "default": "textures/entity/squid",
        "baby": "textures/entity/squid/squid_baby",
        "mesh_squid_baby": "textures/entity/squid_mesh",
        "mesh": "textures/entity/squid_mesh"
      },
      "geometry": {
        "default": "geometry.squid",
        "baby": "geometry.squid.baby",
        "mesh_squid_baby": "geometry.squid_baby.mesh",
        "mesh": "geometry.squid.mesh"
      },
      "animations": {
        "move": "animation.squid.move",
        "squid_rotate": "animation.squid.rotate"
      },
      "scripts": {
        "animate": [
          "move",
          "squid_rotate"
        ],
        "scale": "query.is_baby ? 2.0 : 1.0"
      },
      "render_controllers": [
        "controller.render.squid.v2.mesh"
      ],
      "spawn_egg": {
        "texture": "spawn_egg_squid"
      }
    }
  }
