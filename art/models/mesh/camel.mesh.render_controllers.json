{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.camel.v2.mesh": {
      "geometry": "(!query.is_baby) ? Geometry.mesh : ((query.is_baby) ? Geometry.mesh_camel_baby : (query.is_baby ? Geometry.baby : Geometry.default))",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "(!query.is_baby) ? Texture.mesh : ((query.is_baby) ? Texture.mesh_camel_baby : (query.is_baby ? Texture.baby : Texture.default))"
      ],
      "part_visibility": [
        {
          "saddle": "query.is_saddled"
        },
        {
          "bridle": "query.is_saddled"
        },
        {
          "reins*": "query.is_saddled && query.has_rider"
        }
      ]
    }
  }
}
