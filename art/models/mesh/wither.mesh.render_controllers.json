{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.wither_boss.mesh": {
      "arrays": {
        "textures": {
          "Array.wither_state": [
            "Texture.invulnerable",
            "Texture.default"
          ]
        }
      },
      "geometry": "Geometry.mesh",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.mesh"
      ],
      "overlay_color": {
        "r": "variable.is_invulnerable ? 1.0 : this",
        "g": "variable.is_invulnerable ? 1.0 : this",
        "b": "variable.is_invulnerable ? 1.0 : this",
        "a": "variable.is_invulnerable ? query.overlay_alpha : this"
      }
    }
  }
}
