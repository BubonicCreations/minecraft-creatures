{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.mule.v4.mesh": {
      "part_visibility": [
        {
          "Saddle": "query.is_saddled"
        },
        {
          "Bit*": "query.is_saddled"
        },
        {
          "Bridle": "query.is_saddled"
        },
        {
          "Reins*": "query.is_saddled && query.has_rider"
        },
        {
          "Bag*": "query.is_chested"
        },
        {
          "Ear*": false
        }
      ],
      "geometry": "(!query.is_baby && !query.is_chested) ? Geometry.mesh : ((query.is_baby && !query.is_chested) ? Geometry.mesh_mule_baby : (query.is_baby ? Geometry.baby : Geometry.default))",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "(!query.is_baby && !query.is_chested) ? Texture.mesh : ((query.is_baby && !query.is_chested) ? Texture.mesh_mule_baby : (query.is_baby ? Texture.baby_mule : Texture.mule))",
        "Texture.markings_none",
        "Texture.armor_none"
      ]
    }
  }
}
