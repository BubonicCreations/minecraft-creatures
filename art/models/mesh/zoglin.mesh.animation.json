{
  "format_version": "1.8.0",
  "animations": {
    "animation.zoglin.mesh.walk": {
      "loop": true,
      "bones": {
        "left_ear": {
          "rotation": [
            "((!query.is_baby) || (query.is_baby)) ? (math.clamp(0.0, -40, 40)) : (0.0)",
            0.0,
            "variable.tcos_left_side * 0.5"
          ]
        },
        "right_ear": {
          "rotation": [
            "((!query.is_baby) || (query.is_baby)) ? (math.clamp(0.0, -40, 40)) : (0.0)",
            0.0,
            "variable.tcos_right_side * 0.5"
          ]
        },
        "leg_back_right": {
          "rotation": [
            "((!query.is_baby) || (query.is_baby)) ? (math.clamp(variable.tcos_right_side, -40, 40)) : (variable.tcos_right_side)",
            0.0,
            0.0
          ]
        },
        "leg_back_left": {
          "rotation": [
            "((!query.is_baby) || (query.is_baby)) ? (math.clamp(variable.tcos_left_side, -40, 40)) : (variable.tcos_left_side)",
            0.0,
            0.0
          ]
        },
        "leg_front_right": {
          "rotation": [
            "((!query.is_baby) || (query.is_baby)) ? (math.clamp(-variable.tcos_right_side, -40, 40)) : (-variable.tcos_right_side)",
            0.0,
            0.0
          ]
        },
        "leg_front_left": {
          "rotation": [
            "((!query.is_baby) || (query.is_baby)) ? (math.clamp(-variable.tcos_left_side, -40, 40)) : (-variable.tcos_left_side)",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.zoglin.mesh.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "relative_to": {
            "rotation": "entity"
          },
          "rotation": [
            "((!query.is_baby) || (query.is_baby)) ? (math.clamp(0, -25, 25)) : (0)",
            "((!query.is_baby) || (query.is_baby)) ? (math.clamp(query.target_y_rotation - this, -25, 25)) : (query.target_y_rotation - this)",
            0
          ]
        }
      }
    },
    "animation.zoglin.mesh.hoglin_baby_scaling": {
      "loop": true,
      "bones": {
        "head": {
          "position": [
            "(query.is_baby) ? (0.0) : (0.0)",
            "(query.is_baby) ? (0.0) : (10.0)",
            "(query.is_baby) ? (0.0) : (4.0)"
          ],
          "scale": [
            "(query.is_baby) ? (1.0) : (1.4)",
            "(query.is_baby) ? (1.0) : (1.4)",
            "(query.is_baby) ? (1.0) : (1.4)"
          ]
        }
      }
    }
  }
}
