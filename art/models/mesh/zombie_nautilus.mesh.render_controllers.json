{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.zombie_nautilus.mesh": {
      "arrays": {
        "geometries": {
          "Array.geometries": [
            "Geometry.default",
            "Geometry.coral"
          ]
        },
        "textures": {
          "Array.textures": [
            "Texture.default",
            "Texture.coral"
          ]
        }
      },
      "geometry": "(!query.is_saddled && !variable.has_armor) ? Geometry.mesh : (Array.geometries[v.variant_index])",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "(!query.is_saddled && !variable.has_armor) ? Texture.mesh : (Array.textures[v.variant_index])"
      ],
      "part_visibility": [
        {
          "head": "!variable.has_armor",
          "yellow_coral": "!variable.has_armor",
          "pink_coral": "!variable.has_armor",
          "blue_coral": "!variable.has_armor",
          "red_coral": "!variable.has_armor"
        }
      ]
    }
  }
}
