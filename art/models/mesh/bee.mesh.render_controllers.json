{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.bee.v2.mesh": {
      "arrays": {
        "textures": {
          "array.skins": [
            "texture.default",
            "texture.nectar",
            "texture.angry",
            "texture.angry_nectar"
          ],
          "array.baby_skins": [
            "texture.baby_default",
            "texture.baby_nectar",
            "texture.baby_angry",
            "texture.baby_angry_nectar"
          ]
        }
      },
      "geometry": "(!query.is_baby) ? Geometry.mesh : ((query.is_baby) ? Geometry.mesh_bee_baby : (query.is_baby ? Geometry.baby : Geometry.default))",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "(!query.is_baby) ? Texture.mesh : ((query.is_baby) ? Texture.mesh_bee_baby : (query.is_baby ? array.baby_skins[query.property('minecraft:has_nectar') + query.is_angry * 2] : array.skins[query.property('minecraft:has_nectar') + query.is_angry * 2]))"
      ]
    }
  }
}
