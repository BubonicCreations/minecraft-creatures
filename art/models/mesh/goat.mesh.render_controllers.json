      "part_visibility": [
        {
          "right_horn": "variable.goat_has_right_horn"
        },
        {
          "left_horn": "variable.goat_has_left_horn"
        }
      ],
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "(!query.is_baby) ? Texture.mesh : ((query.is_baby) ? Texture.mesh_goat_baby : (query.is_baby ? Texture.baby : Texture.default))"
      ]
    }
  }
}
