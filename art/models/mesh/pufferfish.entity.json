{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:pufferfish",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "pufferfish"
      },
      "textures": {
        "default": "textures/entity/fish/pufferfish",
        "mesh_pufferfish_large": "textures/entity/fish/pufferfish_large_mesh",
        "mesh_pufferfish_mid": "textures/entity/fish/pufferfish_mid_mesh",
        "mesh": "textures/entity/fish/pufferfish_mesh"
      },
      "geometry": {
        "default": "geometry.pufferfish.small.v1.8",
        "mid": "geometry.pufferfish.mid.v1.8",
        "large": "geometry.pufferfish.large.v1.8",
        "mesh_pufferfish_large": "geometry.pufferfish_large.mesh",
        "mesh_pufferfish_mid": "geometry.pufferfish_mid.mesh",
        "mesh": "geometry.pufferfish.mesh"
      },
      "scripts": {
        "pre_animation": [
          "variable.ZRot = !query.is_in_water ? Math.cos(query.time_stamp * 14.32) * 90 : 0.0;",
          "variable.AnimationAmountBlend = Math.lerp(variable.AnimationAmountPrev, variable.AnimationAmount, query.frame_alpha);"
        ],
        "animate": [
          "general"
        ]
      },
      "animations": {
        "flop": "animation.pufferfish.flop",
        "swim": "animation.pufferfish.swim",
        "general": "controller.animation.fish.general"
      },
      "render_controllers": [
        "controller.render.pufferfish.small.mesh",
        {
          "controller.render.pufferfish.medium": "(query.variant == 1) && (!((query.variant == 0) || (query.variant == 1) || (query.variant == 2)))"
        },
        {
          "controller.render.pufferfish.large": "(query.variant == 2) && (!((query.variant == 0) || (query.variant == 1) || (query.variant == 2)))"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_pufferfish"
      }
    }
  }
}
